rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Provision administrators only via Firebase Console or Admin SDK, never from the app.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true;
    }

    match /administradores/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    function isOwner() {
      return signedIn() && resource.data.usuarioId == request.auth.uid;
    }

    function validText() {
      return request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() >= 10
        && request.resource.data.descricao.size() <= 5000
        && request.resource.data.categoriaId is string;
    }

    match /denuncias/{denunciaId} {
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'titulo', 'categoriaId', 'descricao', 'dataOcorrencia',
          'usuarioId', 'localizacao', 'fotos', 'data', 'status', 'protocolo'
        ])
        && request.resource.data.status == 'ENVIADA'
        && request.resource.data.data == request.time
        && request.resource.data.protocolo is string
        && validText();

      allow read: if isOwner() || isAdmin();

      // Citizens may edit content, never workflow, ownership or timestamps.
      allow update: if (isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['titulo', 'descricao', 'categoriaId'])
        && validText())
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'observacaoAdmin', 'atualizadoEm', 'atualizadoPor'])
          && request.resource.data.status in ['ENVIADA', 'EM_ANALISE', 'AGUARDANDO_INFORMACOES', 'VALIDADA', 'EM_ATENDIMENTO', 'RESOLVIDA', 'REJEITADA']
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.atualizadoEm == request.time);

      allow delete: if isOwner() || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
